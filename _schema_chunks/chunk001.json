{
  "openapi": "3.0.4",
  "info": {
    "title": "Veeam ONE REST API",
    "version": "2.3"
  },
  "servers": [
    {
      "url": "https://server:1239/"
    }
  ],
  "paths": {
    "/api/v2.3/about": {
      "get": {
        "tags": [
          "About"
        ],
        "summary": "Get Veeam ONE Server Information",
        "description": "Returns a resource representation of information on Veeam ONE server and reporting service.",
        "operationId": "About_GetAbout",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerInformation"
                },
                "example": {
                  "name": "Veeam ONE Reporting Service",
                  "version": "13.0.1.5848",
                  "machine": "avonr2.tech.local",
                  "logPath": "C:\\ProgramData\\Veeam\\Veeam ONE\\Logs\\Reporter"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2.3/about/installationInfo": {
      "get": {
        "tags": [
          "About"
        ],
        "summary": "Get Veeam ONE Installation Information",
        "description": "Returns a resource representation of information on Veeam ONE installation.",
        "operationId": "About_GetServiceInfo",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VeeamOneServiceInfo"
                },
                "example": {
                  "product": "Veeam ONE",
                  "version": "13.0.1.584",
                  "installationUid": "73a0bc96-bee3-4e14-8f53-27625d2adb35"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2.3/about/logs": {
      "post": {
        "tags": [
          "About"
        ],
        "summary": "Collect Log Archive",
        "description": "Initiates a log archive collection task.",
        "operationId": "About_StartVeeamOneLogsTask",
        "requestBody": {
          "description": "Task request.",
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/VeeamOneLogsRequest"
                  }
                ]
              },
              "example": {
                "fromDate": "2026-01-01T00:00:00Z"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsyncTaskStatus"
                },
                "example": {
                  "id": "9b2e6d41-7c3a-4f8e-a1b0-2f5c8d9e0a71",
                  "state": "Running",
                  "result": null
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2.3/about/logs/tasks/{taskId}/status": {
      "post": {
        "tags": [
          "About"
        ],
        "summary": "Get Log Archive Collection Task",
        "description": "Returns a resource representation of status and result of a log archive collection task with the specified ID.",
        "operationId": "About_GetVeeamOneLogsTaskStatus",
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "description": "Task ID.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsyncTaskStatus"
                },
                "example": {
                  "id": "9b2e6d41-7c3a-4f8e-a1b0-2f5c8d9e0a71",
                  "state": "Completed",
                  "result": "C:\\ProgramData\\Veeam\\Veeam ONE\\Logs\\Reporter\\VeeamOneLogs_20260101.zip"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2.3/about/updater": {
      "get": {
        "tags": [
          "About"
        ],
        "summary": "Get Veeam Updater URL",
        "description": "Returns the Veeam Updater web interface URL with embedded access token for the current server.",
        "operationId": "About_GetUpdaterUrl",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdaterInfo"
                },
                "example": {
                  "url": "http://avonr2.tech.local:9393/?token=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxIn0.signature"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
